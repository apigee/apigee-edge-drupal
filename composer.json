{
    "name": "drupal/apigee_edge",
    "license": "GPL-2.0-or-later",
    "type": "drupal-module",
    "description": "Apigee for Drupal.",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "apigee/apigee-client-php": "dev-issue-newer-php-4.x",
        "drupal/core": "^11.3",
        "drupal/entity": "^1.0",
        "drupal/key": "^1.8",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "apigee/apigee-mock-client-php": "dev-issue-14",
        "drupal/drupal-extension": "~5",
        "cweagans/composer-patches": "^1.6",
        "drupal/core-dev": "^11.3",
        "drush/drush": "^13.3",
        "mglaman/drupal-check": "1.5",
        "phpmd/phpmd": "^2.8.2",
        "phpmetrics/phpmetrics": "^2.5",
        "phpstan/phpstan": "^1.12"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "drush": {
            "services": {
                "drush.services.yml": "^13"
            }
        }
    },
    "repositories": {
        "forked-apigee_mock_client_php": {
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-mock-client-php"
        },
        "forked-apigee_client_php": {
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-client-php"
        }
    }
}
